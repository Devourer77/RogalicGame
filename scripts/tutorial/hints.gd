static func is_off() -> bool:
	return Meta.hints_seen.has(OFF)


# Нужно ли показать подсказку id (её ещё не видели и подсказки не выключены)
static func wanted(id: String) -> bool:
	return TEXTS.has(id) and not is_off() and not Meta.hints_seen.has(id)


static func mark_seen(id: String) -> void:
	if not Meta.hints_seen.has(id):
		Meta.hints_seen.append(id)
		Meta.save()


static func turn_off() -> void:
	mark_seen(OFF)


static func title(id: String) -> String:
	return TEXTS[id][0]


static func text(id: String) -> String:
	return TEXTS[id][1]


# Показать в окошке panel подсказку id (и сразу отметить как увиденную)
static func show_in(panel: TutorPanel, id: String) -> void:
	mark_seen(id)
	panel.show_step("подсказка", title(id), text(id), "Понятно", "Не показывать подсказки")


# Экран забега: при первом заходе — окошко слева внизу поверх экрана.
# Зовётся из _ready() экрана: Hints.offer(self, "shop").
static func offer(screen: Node, id: String) -> void:
	if not wanted(id) or Run.tutorial:
		return
	var layer := CanvasLayer.new()
	layer.layer = 20   # поверх всего на экране
	screen.add_child(layer)
	var holder := Control.new()
	holder.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	holder.mouse_filter = Control.MOUSE_FILTER_IGNORE
	holder.theme = UiKit.theme()
	layer.add_child(holder)
	var panel := TutorPanel.new()
	holder.add_child(panel)
	show_in(panel, id)
	# Слева внизу: на экранах забега кнопки обычно по центру.
	# Привязка к углу и рост вверх — высота окошка зависит от текста.
	panel.set_anchors_preset(Control.PRESET_BOTTOM_LEFT)
	panel.grow_vertical = Control.GROW_DIRECTION_BEGIN
	panel.offset_left = 14.0
	panel.offset_right = 14.0 + TutorPanel.WIDTH
	panel.offset_top = -14.0
	panel.offset_bottom = -14.0
	panel.next_pressed.connect(layer.queue_free)
	panel.skip_pressed.connect(func() -> void:
		turn_off()
		layer.queue_free())
