[gd_resource type="Resource" script_class="DeckPreset" load_steps=10 format=3]

[ext_resource type="Script" path="res://scripts/data/deck_preset.gd" id="1_preset"]
[ext_resource type="Script" path="res://scripts/data/card_data.gd" id="2_card"]
[ext_resource type="Resource" path="res://resources/cards/base/mb_staff.tres" id="c_mb_staff"]
[ext_resource type="Resource" path="res://resources/cards/base/mb_spark.tres" id="c_mb_spark"]
[ext_resource type="Resource" path="res://resources/cards/base/mb_pull.tres" id="c_mb_pull"]
[ext_resource type="Resource" path="res://resources/cards/base/mb_swap.tres" id="c_mb_swap"]
[ext_resource type="Resource" path="res://resources/cards/base/mb_crack.tres" id="c_mb_crack"]
[ext_resource type="Resource" path="res://resources/cards/base/mb_shield.tres" id="c_mb_shield"]
[ext_resource type="Resource" path="res://resources/cards/base/mb_discharge.tres" id="c_mb_discharge"]

[resource]
script = ExtResource("1_preset")
id = "kinetic"
title = "Перестановщик"
description = "Двигает поле, а не бьёт. Притяжение и Обмен ставят врагов в клещи, под Рыцаря или в трясину; Надлом роняет деревья и взрывает бочки."
cards = Array[ExtResource("2_card")]([ExtResource("c_mb_staff"), ExtResource("c_mb_spark"), ExtResource("c_mb_spark"), ExtResource("c_mb_pull"), ExtResource("c_mb_swap"), ExtResource("c_mb_crack"), ExtResource("c_mb_shield"), ExtResource("c_mb_discharge")])
unlock = ""
