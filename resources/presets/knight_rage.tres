[resource]
script = ExtResource("1_preset")
id = "rage"
title = "Берсерк"
description = "★ Вихрь стали с первого боя. Вызов и Поднять щит — чтобы бить в Рыцаря, а не в Мага; каждый удар — ярость, Кровавый удар и Вихрь её тратят."
cards = Array[ExtResource("2_card")]([ExtResource("c_kb_sword"), ExtResource("c_kb_sword"), ExtResource("c_kb_blood"), ExtResource("c_kb_warcry"), ExtResource("c_kb_taunt"), ExtResource("c_kb_shield"), ExtResource("c_kb_ram"), ExtResource("c_kb_whirl")])
unlock = "act2_boss"
