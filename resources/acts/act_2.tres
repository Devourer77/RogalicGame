[resource]
script = ExtResource("1_act")
number = 2
title = "Пепельный тракт"
intro = "Выжженная дорога к Шпилю. Поверху — тракт в пепле и знамёнах Культа, понизу — пещеры и мёртвая лаборатория технарей. Обе дороги сходятся у жерла вулкана."
branch_titles = Array[String](["Тракт", "Подземье"])
fork_title = "Развилка: тракт или подземье"
common_title = "У жерла вулкана"
map_bg = "res://assets/textures/map/map_bg_act2.jpg"
encounters = Array[ExtResource("1_enc")]([ExtResource("2_e"), ExtResource("3_e"), ExtResource("4_e"), ExtResource("5_e"), ExtResource("6_e"), ExtResource("7_e"), ExtResource("8_e"), ExtResource("9_e"), ExtResource("10_e"), ExtResource("11_e"), ExtResource("12_e"), ExtResource("13_e"), ExtResource("14_e"), ExtResource("15_e"), ExtResource("16_e"), ExtResource("17_e"), ExtResource("18_e"), ExtResource("19_e"), ExtResource("20_e"), ExtResource("21_e"), ExtResource("22_e"), ExtResource("23_e"), ExtResource("24_e")])
elite_pool = Array[ExtResource("1_enc")]([ExtResource("25_e"), ExtResource("26_e"), ExtResource("27_e"), ExtResource("28_e"), ExtResource("29_e")])
boss_pool = Array[ExtResource("1_enc")]([ExtResource("30_e"), ExtResource("31_e"), ExtResource("32_e")])
arenas_left = Array[String](["wagons", "ashfield", "shrine", "lava_beds", "springs", "tower", "dunes", "pass"])
arenas_right = Array[String](["embers", "sphere_hall", "steamworks", "mine", "rift_lab", "lake", "assembly", "fungus"])
boss_arena = "crater"
lair_spirits = Array[String](["ash", "stone"])
borrow_from = 0
enemy_hp_mult = 1.0
enemy_damage_add = 0
