[resource]
script = ExtResource("1_spirit")
id = "storm"
title = "Грозовик"
description = "Гроза без неба. Злится, что ей некуда упасть."
passive_text = "удары героя по врагу в луже +2 урона."
color = Color(0.9, 0.86, 0.55, 1)
icon = "bolt"
call_card = ExtResource("c1")
