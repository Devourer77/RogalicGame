[resource]
script = ExtResource("1_spirit")
id = "magma"
title = "Сердце Жерла"
description = "Пленник Сосуда Венца. Вулкан помнит, кто его выпустил."
passive_text = "лава под героем застывает коркой: по ней можно пройти, толкнули в лаву — без урона."
color = Color(1, 0.45, 0.12, 1)
icon = "fire"
is_unique = true
call_card = ExtResource("c1")
mage_cards = Array[ExtResource("2_card")]([ExtResource("c2"), ExtResource("c3"), ExtResource("c4"), ExtResource("c5"), ExtResource("c6"), ExtResource("c7")])
knight_cards = Array[ExtResource("2_card")]([ExtResource("c8"), ExtResource("c9"), ExtResource("c10"), ExtResource("c11"), ExtResource("c12"), ExtResource("c13")])
mixed_cards = Array[ExtResource("2_card")]([ExtResource("c14"), ExtResource("c15"), ExtResource("c16"), ExtResource("c17")])
